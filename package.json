{
  "name": "interactive-drama",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22",
    "install-node": "22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter studio --filter server dev",
    "start": "node --env-file-if-exists=.env apps/server/dist/main.js",
    "build": "pnpm -r build",
    "e2e": "playwright test",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
